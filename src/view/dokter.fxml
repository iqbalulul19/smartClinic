<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DokterController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                     <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                     </padding>
                  </Button>
                  <Label text="Manajemen Data Dokter" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
               <children>
                  <Label text="Cari Dokter:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCari" prefWidth="300.0" promptText="Ketik nama atau spesialis..." style="-fx-padding: 8;" />
                  <Button mnemonicParsing="false" onAction="#handleCari" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="🔍 Cari">
                     <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                     </padding>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#handleRefresh" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="🔄 Refresh Tabel">
                     <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tableDokter" onMouseClicked="#handleTableClick" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colID" prefWidth="100.0" text="ID" />
                      <TableColumn fx:id="colNama" prefWidth="270.0" text="Nama Dokter" />
                      <TableColumn fx:id="colSpesialis" prefWidth="250.0" text="Spesialisasi" />
                      <TableColumn fx:id="colNoHP" prefWidth="250.0" text="No. Telepon / HP" />
                    </columns>
                  </TableView>

                  <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;">
                     <children>
                        <Label text="Form Data Dokter" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                        <Separator prefWidth="200.0" />
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Nama Lengkap:" />
                              <TextField fx:id="txtNama" promptText="Masukkan nama dokter..." style="-fx-padding: 8;" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Spesialisasi:" />
                              <TextField fx:id="txtSpesialis" promptText="Contoh: Poli Gigi" style="-fx-padding: 8;" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Nomor HP:" />
                              <TextField fx:id="txtNoHP" promptText="08xxxxxxxxxx" style="-fx-padding: 8;" />
                           </children>
                        </VBox>
                        
                        <Separator prefWidth="200.0" />
                        
                        <GridPane hgap="10.0" vgap="10.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSimpan" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="💾 Simpan" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHapus" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="🗑 Hapus" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearFields" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;" text="✖ Batal" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                        
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>