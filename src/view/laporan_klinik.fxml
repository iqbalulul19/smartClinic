<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://fxml.com/fxml/1" fx:controller="controller.LaporanKlinikController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
         <children>
            <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
               <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
            </Button>
            <Label text="📈 Dashboard Laporan Klinik" textFill="#2c3e50">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleCetakLaporan" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" text="🖨 Cetak Laporan PDF" />
         </children>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;">
         <content>
            <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #f4f6f9;">
               
               <HBox spacing="20.0">
                  <children>
                     <VBox alignment="CENTER" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="TOTAL PASIEN TERDAFTAR" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <Label fx:id="lblTotalPasien" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        </children>
                     </VBox>
                     
                     <VBox alignment="CENTER" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #9b59b6; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="TOTAL PEMERIKSAAN (PREDIKSI)" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <Label fx:id="lblTotalPrediksi" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        </children>
                     </VBox>

                     <VBox alignment="CENTER" prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: #e67e22; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="MACAM OBAT DI GUDANG" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                           <Label fx:id="lblTotalObat" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;">
                  <children>
                     <Label text="📅 Filter Rentang Waktu:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                     <DatePicker fx:id="dpMulai" promptText="Tanggal Mulai" />
                     <Label text="s/d" style="-fx-font-weight: bold;" />
                     <DatePicker fx:id="dpSelesai" promptText="Tanggal Akhir" />
                     <Button mnemonicParsing="false" onAction="#handleFilterTanggal" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🔍 Terapkan Filter" />
                  </children>
               </HBox>

               <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                  <children>
                     <Label text="📊 Grafik Kunjungan Pasien" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;" />
                     <BarChart fx:id="barChartKunjungan" prefHeight="250.0">
                        <xAxis><CategoryAxis fx:id="xAxis" label="Tanggal Kunjungan" /></xAxis>
                        <yAxis><NumberAxis fx:id="yAxis" label="Jumlah Pasien" tickUnit="1" minorTickCount="0" /></yAxis>
                     </BarChart>
                  </children>
               </VBox>

               <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                  <children>
                     <Label text="Riwayat Pemeriksaan / Prediksi Terbaru" textFill="#2c3e50">
                        <font><Font name="System Bold" size="16.0" /></font>
                        <padding><Insets bottom="10.0" /></padding>
                     </Label>
                     <TableView fx:id="tableRiwayat" prefHeight="300.0" style="-fx-border-color: #ecf0f1; -fx-border-radius: 5;">
                        <columns>
                           <TableColumn fx:id="colTanggal" prefWidth="200.0" text="Tanggal" />
                           <TableColumn fx:id="colNama" prefWidth="300.0" text="Nama Pasien" />
                           <TableColumn fx:id="colHasil" prefWidth="500.0" text="Hasil Pemeriksaan / Aktivitas" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                     </TableView>
                  </children>
               </VBox>

            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>