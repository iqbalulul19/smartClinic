<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../style/global.css" prefHeight="700.0" prefWidth="1024.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://fxml.com/fxml/1" fx:controller="controller.PoliController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
            </Button>
            <Label text="Manajemen Data Poli" textFill="#2c3e50">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;">
                <Label text="Form Data Poli" textFill="#2c3e50">
                    <font><Font name="System Bold" size="18.0" /></font>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Label>
                
                <Label text="Nama Poli:" />
                <TextField fx:id="txtNamaPoli" promptText="Contoh: Poli Umum" />
                
                <Label text="Keterangan:" />
                <TextArea fx:id="txtKeterangan" prefHeight="100.0" promptText="Masukkan keterangan poli..." wrapText="true" />
                
                <Button mnemonicParsing="false" onAction="#handleSimpan" prefWidth="300.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Simpan Data Poli">
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </Button>
            </VBox>

            <VBox HBox.hgrow="ALWAYS">
                <TableView fx:id="tablePoli" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colNama" prefWidth="150.0" text="Nama Poli" />
                        <TableColumn fx:id="colKeterangan" prefWidth="300.0" text="Keterangan" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>