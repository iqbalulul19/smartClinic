                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                      </rowConstraints>
                                       <children>
                                          <Label text="Pregnancies:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                          <TextField fx:id="txtPregnancies" promptText="misal: 1" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                          <Label text="Glucose:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                          <TextField fx:id="txtGlucose" promptText="misal: 120" GridPane.columnIndex="1" GridPane.rowIndex="1" />
