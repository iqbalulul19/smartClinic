                      <TableColumn fx:id="colTanggal" prefWidth="110.0" text="Tanggal" />
                      <TableColumn fx:id="colPasien" prefWidth="120.0" text="Nama Pasien" />
                      <TableColumn fx:id="colHasil" prefWidth="160.0" text="Hasil" />
                    </columns>
                  </TableView>
               </children>
            </VBox>

            <VBox prefHeight="670.0" prefWidth="680.0" spacing="15.0" HBox.hgrow="ALWAYS">
