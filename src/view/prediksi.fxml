                                          <TextField fx:id="txtBMI" promptText="misal: 25.4" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                          <Label text="Diabetes Pedigree:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                          <TextField fx:id="txtPedigree" promptText="misal: 0.5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label text="Age:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                          <TextField fx:id="txtAge" promptText="Otomatis dari Data Pasien" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                       </children>
                                    </GridPane>
                                    <HBox spacing="15.0">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#handlePrediksiDiabetes" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Jalankan Prediksi Diabetes" />
                                          <Button mnemonicParsing="false" onAction="#handleBersihkan" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 15;" text="Bersihkan Form" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                      </Tab>

