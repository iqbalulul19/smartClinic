                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
                  <Label text="Pilih Pasien:" />
                  <ComboBox fx:id="cmbPasien" prefWidth="400.0" promptText="-- Pilih Pasien --" />
                  
                  <Label text="Riwayat Prediksi Sebelumnya" textFill="#2c3e50">
                     <font><Font name="System Bold" size="14.0" /></font>
                     <VBox.margin><Insets top="15.0" /></VBox.margin>
                  </Label>
                  
                  <TableView fx:id="tableRiwayat" prefHeight="450.0" prefWidth="400.0" VBox.vgrow="ALWAYS">
