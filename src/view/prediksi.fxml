                                          <TextField fx:id="txtBloodPressure" promptText="misal: 80" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                          <Label text="Skin Thickness:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                          <TextField fx:id="txtSkinThickness" promptText="misal: 20" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                          <Label text="Insulin:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                          <TextField fx:id="txtInsulin" promptText="misal: 85" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                       </children>
                                    </GridPane>
                                    <GridPane hgap="15.0" vgap="15.0">
