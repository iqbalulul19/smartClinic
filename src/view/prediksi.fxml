<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PrediksiController">
   <children>
      
      <HBox alignment="CENTER_LEFT" layoutX="15.0" layoutY="15.0" prefHeight="50.0" prefWidth="1170.0" spacing="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 3; -fx-padding: 5 15 5 15; -fx-cursor: hand;" text="⬅" />
            <Label text="Prediksi Machine Learning" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <HBox layoutX="14.0" layoutY="80.0" prefHeight="600.0" prefWidth="1170.0" spacing="20.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="80.0">
