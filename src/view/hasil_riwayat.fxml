<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HasilRiwayatController">
   <children>
      
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                    <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
                </Button>
                <Label text="📊 Laporan Hasil &amp; Riwayat Prediksi" textFill="#2c3e50">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </children>
      </HBox>

      <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="90.0">
         <children>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="txtCari" prefWidth="400.0" promptText="🔍 Cari nama pasien atau hasil..." style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: #dcdde1; -fx-border-radius: 20; -fx-background-color: #f8f9fa;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="Pilih baris tabel untuk mencetak surat PDF" textFill="#7f8c8d">
                     <font><Font name="System Italic" size="14.0" /></font>
                  </Label>
               </children>
            </HBox>

            <TableView fx:id="tableHasilML" style="-fx-background-color: transparent; -fx-border-color: #ecf0f1; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colTanggal" prefWidth="250.0" text="Tanggal Prediksi" />
                <TableColumn fx:id="colPasien" prefWidth="350.0" text="Nama Pasien" />
                <TableColumn fx:id="colHasil" prefWidth="500.0" text="Hasil Prediksi Mesin" />
              </columns>
              <columnResizePolicy>
                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
            </TableView>

            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-padding: 15; -fx-background-radius: 5;">
               <children>
                  <Label text="HASIL PEMERIKSAAN PASIEN TERPILIH" textFill="#2c3e50">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <HBox spacing="30.0">
                     <children>
                        <Label fx:id="lblDetailNama" text="Nama : -" textFill="#34495e"><font><Font size="14.0" /></font></Label>
                        <Label fx:id="lblDetailTanggal" text="Waktu : -" textFill="#34495e"><font><Font size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <Label fx:id="lblDetailHasil" text="Hasil  : Silakan pilih data di tabel" textFill="#e74c3c">
                           <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnCetakIndividu" disable="true" onAction="#handleCetakPDFIndividu" 
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; 
                                       -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;" 
                                text="🖨 Cetak Surat Keterangan (PDF)" />
                    </children>
                  </HBox>
               </children>
            </VBox>
            
         </children>
      </VBox>
      
   </children>
</AnchorPane>