<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PemeriksaanController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <children>
                <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </Button>
                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 24px;" text="Pemeriksaan Medis" />
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.4" style="-fx-padding: 15; -fx-background-color: transparent;">
            <items>
                
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                            <tabs>
                                <Tab text="🕒 Belum Diperiksa (Antrian)">
                                    <VBox spacing="10.0" style="-fx-padding: 15;">
                                        <children>
                                            <TableView fx:id="tableAntrian" onMouseClicked="#handlePilihAntrian" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colNoAntrian" prefWidth="50.0" text="No" />
                                                    <TableColumn fx:id="colNamaPasien" prefWidth="215.0" text="Nama Pasien" />
                                                    <TableColumn fx:id="colKeluhan" prefWidth="215.0" text="Keluhan" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </Tab>
                                
                                <Tab text="✅ Selesai (Riwayat Hari Ini)">
                                    <VBox spacing="10.0" style="-fx-padding: 15;">
                                        <children>
                                            <TableView fx:id="tableRiwayat" onMouseClicked="#handlePilihRiwayat" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colNoRiwayat" prefWidth="50.0" text="No" />
                                                    <TableColumn fx:id="colNamaRiwayat" prefWidth="215.0" text="Nama Pasien" />
                                                    <TableColumn fx:id="colDiagnosaRiwayat" prefWidth="215.0" text="Diagnosa Akhir" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </children>
                </VBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="15.0" style="-fx-padding: 20;">
                                    <children>
                                        <Label style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 18px;" text="📝 Form Hasil Pemeriksaan" />
                                        <Separator />
                                        
                                        <GridPane hgap="15.0" vgap="15.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="120.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="30.0" />
                                                <RowConstraints minHeight="30.0" />
                                                <RowConstraints minHeight="30.0" />
                                                <RowConstraints minHeight="30.0" />
                                                <RowConstraints minHeight="30.0" />
                                                <RowConstraints minHeight="45.0" />
                                                <RowConstraints minHeight="45.0" />
                                            </rowConstraints>
                                            <children>
                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Pasien Terpilih:" GridPane.rowIndex="0" />
                                                <TextField fx:id="txtNamaPasien" editable="false" promptText="Pilih dari tabel kiri..." style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Tekanan Darah:" GridPane.rowIndex="1" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <children>
                                                        <TextField fx:id="txtTekananDarah" prefWidth="120.0" promptText="120/80" />
                                                        <Label style="-fx-text-fill: #7f8c8d;" text="mmHg" />
                                                    </children>
                                                </HBox>

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Gula Darah:" GridPane.rowIndex="2" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <children>
                                                        <TextField fx:id="txtGulaDarah" prefWidth="120.0" promptText="110" />
                                                        <Label style="-fx-text-fill: #7f8c8d;" text="mg/dL" />
                                                    </children>
                                                </HBox>

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Suhu Tubuh:" GridPane.rowIndex="3" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                    <children>
                                                        <TextField fx:id="txtSuhu" prefWidth="120.0" promptText="36.5" />
                                                        <Label style="-fx-text-fill: #7f8c8d;" text="°C" />
                                                    </children>
                                                </HBox>

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Berat Badan:" GridPane.rowIndex="4" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                    <children>
                                                        <TextField fx:id="txtBerat" prefWidth="120.0" promptText="65" />
                                                        <Label style="-fx-text-fill: #7f8c8d;" text="kg" />
                                                    </children>
                                                </HBox>

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Diagnosa:" GridPane.rowIndex="5" GridPane.valignment="TOP">
                                                    <GridPane.margin><Insets top="5.0" /></GridPane.margin>
                                                </Label>
                                                <TextArea fx:id="txtDiagnosa" prefRowCount="2" promptText="Masukkan hasil diagnosa dokter..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                                <Label style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;" text="Catatan Medis:" GridPane.rowIndex="6" GridPane.valignment="TOP">
                                                    <GridPane.margin><Insets top="5.0" /></GridPane.margin>
                                                </Label>
                                                <TextArea fx:id="txtCatatan" prefRowCount="2" promptText="Resep atau tindakan lanjutan..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                            </children>
                                        </GridPane>
                                        
                                        <Separator style="-fx-padding: 10 0;" />
                                        <Label style="-fx-text-fill: #2980b9; -fx-font-weight: bold; -fx-font-size: 18px;" text="💊 Keranjang Resep Obat" />
                                        
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <ComboBox fx:id="cmbObat" prefWidth="250.0" promptText="Pilih Obat dari Gudang..." />
                                                <TextField fx:id="txtJumlahObat" prefWidth="80.0" promptText="Jml" />
                                                <TextField fx:id="txtDosis" prefWidth="150.0" promptText="Dosis (Misal: 3x1)" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnTambahResep" mnemonicParsing="false" onAction="#handleTambahKeKeranjang" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Tambah" />
                                            </children>
                                        </HBox>
                                        
                                        <TableView fx:id="tableResep" prefHeight="150.0" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colResepNama" prefWidth="250.0" style="-fx-alignment: CENTER-LEFT;" text="Nama Obat" />
                                                <TableColumn fx:id="colResepJumlah" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Jumlah" />
                                                <TableColumn fx:id="colResepDosis" prefWidth="270.0" style="-fx-alignment: CENTER-LEFT;" text="Dosis / Aturan Pakai" />
                                            </columns>
                                        </TableView>
                                        
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleBersihkan" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Batal / Bersihkan" />
                                <Button fx:id="btnSimpan" mnemonicParsing="false" onAction="#handleSimpan" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Simpan Pemeriksaan &amp; Resep">
                                    <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                                </Button>
                            </children>
                        </HBox>
                        
                    </children>
                </VBox>
                
            </items>
        </SplitPane>
    </center>
</BorderPane>