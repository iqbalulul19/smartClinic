<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="480.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://fxml.com/fxml/1" fx:controller="controller.RegisterController" style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>
    
    <Label text="REGISTRASI AKUN" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>
    <Label text="Pilih peran dan buat akun Anda" textFill="#7f8c8d">
        <VBox.margin>
            <Insets bottom="10.0" top="-10.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="5.0" prefWidth="320.0">
        <Label text="Daftar Sebagai" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="comboRole" prefWidth="320.0" promptText="-- Pilih Peran Anda --" style="-fx-padding: 4px;" />
    </VBox>
    
    <VBox spacing="5.0" prefWidth="320.0">
        <Label text="Nama Lengkap" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtNama" promptText="Masukkan nama lengkap asli..." style="-fx-padding: 8px;" />
    </VBox>
    
    <VBox spacing="5.0" prefWidth="320.0">
        <Label text="Username Baru" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtUsername" promptText="Buat username..." style="-fx-padding: 8px;" />
    </VBox>
    
    <VBox spacing="5.0" prefWidth="320.0">
        <Label text="Password" style="-fx-font-weight: bold;" />
        <PasswordField fx:id="txtPassword" promptText="Buat password..." style="-fx-padding: 8px;" />
    </VBox>

    <VBox spacing="5.0" prefWidth="320.0">
        <Label text="Konfirmasi Password" style="-fx-font-weight: bold;" />
        <PasswordField fx:id="txtConfirmPassword" promptText="Ketik ulang password..." style="-fx-padding: 8px;" />
    </VBox>
    
    <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnRegister" text="📝 Daftar Akun" prefWidth="180.0" onAction="#handleRegister" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px; -fx-cursor: hand;" />
        
        <Label text="Sudah punya akun?" style="-fx-text-fill: #7f8c8d; -fx-padding: 10 0 0 0;" />
        <Button text="⬅ Kembali ke Login" onAction="#handleGoToLogin" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-underline: true; -fx-font-weight: bold;" />
    </VBox>
</VBox>