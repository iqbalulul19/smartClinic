<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../style/global.css" prefHeight="700.0" prefWidth="1024.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://fxml.com/fxml/1" fx:controller="controller.PendaftaranController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <children>
                <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                    <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
                </Button>
                <Label text="Pendaftaran Pasien Baru" textFill="#2c3e50">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.45" style="-fx-padding: 15; -fx-background-color: transparent;">
            <items>
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        <Label text="📝 Biodata Pasien &amp; Keluhan" textFill="#2980b9">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Separator />
                        
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" VBox.vgrow="ALWAYS">
                            <content>
                                <GridPane hgap="10.0" vgap="15.0" style="-fx-padding: 0 20 10 0;">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="30.0" />
                                        <RowConstraints minHeight="30.0" />
                                        <RowConstraints minHeight="30.0" />
                                        <RowConstraints minHeight="30.0" />
                                        <RowConstraints minHeight="50.0" />
                                        <RowConstraints minHeight="50.0" />
                                        <RowConstraints minHeight="30.0" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Nama Lengkap:" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtNama" promptText="Masukkan nama pasien..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Umur (Tahun):" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtUmur" promptText="misal: 25" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Jenis Kelamin:" GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cmbGender" maxWidth="1.7976931348623157E308" promptText="-- Pilih --" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Nomor HP:" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtNoHP" promptText="08xxxxxxxxxx" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Alamat:" GridPane.rowIndex="4" />
                                        <TextArea fx:id="txtAlamat" prefRowCount="2" promptText="Alamat tempat tinggal..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                        
                                        <Label text="Keluhan Medis:" GridPane.rowIndex="5" />
                                        <TextArea fx:id="txtKeluhan" prefRowCount="2" promptText="Sakit yang dirasakan..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                        <Label text="Pilih Dokter:" GridPane.rowIndex="6">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <ComboBox fx:id="cmbDokter" maxWidth="1.7976931348623157E308" promptText="-- Pilih Jadwal Dokter --" style="-fx-border-color: #3498db; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                    </children>
                                </GridPane>
                            </content>
                        </ScrollPane>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Button mnemonicParsing="false" onAction="#handleBersihkan" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Bersihkan" />
                            <Button mnemonicParsing="false" onAction="#handleHapus" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Batal" />
                            <Button mnemonicParsing="false" onAction="#handleUbah" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="✏ Ubah" />
                            <Button mnemonicParsing="false" onAction="#handleDaftar" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📥 Daftar" />
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        <Label text="📋 Antrian Masuk Hari Ini" textFill="#2c3e50">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <TableView fx:id="tableAntrian" onMouseClicked="#handlePilihAntrian" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNoAntrian" prefWidth="60.0" text="Antrian" />
                                <TableColumn fx:id="colNamaPasien" prefWidth="160.0" text="Nama Pasien" />
                                <TableColumn fx:id="colDokter" prefWidth="160.0" text="Dokter Tujuan" />
                                <TableColumn fx:id="colKeluhan" prefWidth="241.0" text="Keluhan" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>