<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1024.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://fxml.com/fxml/1" fx:controller="controller.PasienController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <children>
                <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅">
                    <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
                </Button>
                <Label text="Master Data Pasien" textFill="#2c3e50">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.6" style="-fx-padding: 15; -fx-background-color: transparent;">
            <items>
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        <Label text="📋 Daftar Pasien Terdaftar" textFill="#2c3e50">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <TableView fx:id="tablePasien" onMouseClicked="#handlePilihTabel" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                                <TableColumn fx:id="colNama" prefWidth="160.0" text="Nama Pasien" />
                                <TableColumn fx:id="colUmur" prefWidth="70.0" text="Umur" />
                                <TableColumn fx:id="colGender" prefWidth="110.0" text="Gender" />
                                <TableColumn fx:id="colHp" prefWidth="120.0" text="No. HP" />
                                <TableColumn fx:id="colAlamat" prefWidth="190.0" text="Alamat" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 1);">
                    <children>
                        <Label text="📝 Form Data Pasien" textFill="#2980b9">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Separator />
                        
                        <GridPane hgap="10.0" vgap="15.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="30.0" />
                                <RowConstraints minHeight="60.0" />
                            </rowConstraints>
                            <children>
                                <Label text="ID Pasien:" GridPane.rowIndex="0" />
                                <TextField fx:id="txtIdPasien" editable="false" promptText="Otomatis (Auto)" style="-fx-background-color: #ecf0f1; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Nama Lengkap:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNama" promptText="Masukkan nama..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Umur:" GridPane.rowIndex="2" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <TextField fx:id="txtUmur" prefWidth="80.0" promptText="25" />
                                    <Label text="Tahun" textFill="#7f8c8d" />
                                </HBox>

                                <Label text="Jenis Kelamin:" GridPane.rowIndex="3" />
                                <ComboBox fx:id="cmbGender" maxWidth="1.7976931348623157E308" promptText="-- Pilih --" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Nomor HP:" GridPane.rowIndex="4" />
                                <TextField fx:id="txtHp" promptText="08xxxxxxxxxx" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Alamat:" GridPane.rowIndex="5" GridPane.valignment="TOP"><GridPane.margin><Insets top="5.0"/></GridPane.margin></Label>
                                <TextArea fx:id="txtAlamat" promptText="Alamat lengkap..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                        
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSimpan" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Tambah" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUbah" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="✏ Update" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHapus" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Delete" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBersihkan" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Clear" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>